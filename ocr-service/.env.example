# Generate a value with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TOPOROTOR_OCR_TOKEN=
# Optional: TOPOROTOR_OCR_TOKENS=<token1>,<token2>  (one per device; entries under 32 bytes are skipped and reported by /ready)
# Optional: TOPOROTOR_OCR_SLOTS=2  (concurrent OCR jobs per worker)
# Optional: TOPOROTOR_CATALOG_PATH=/app/data/places.json
