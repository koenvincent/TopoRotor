# Godot toolchain pin shared by .github/workflows/ci.yml and android.yml.
# Plain KEY=VALUE lines only; both workflows validate this file and append it to $GITHUB_ENV.
# To upgrade: change GODOT_VERSION and copy both hashes from the SHA512-SUMS.txt of that
# release (Godot_v<version>-stable_linux.x86_64.zip and Godot_v<version>-stable_export_templates.tpz).
GODOT_VERSION=4.5.1
